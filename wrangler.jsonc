// Buddy Account บน Cloudflare (S1 ของ docs/20 · HANDOFF ข้อ 105) — Worker (cloud/worker.js) + container จาก Dockerfile ที่ราก repo
// deploy: Workers Builds (เชื่อม GitHub ในหน้า Cloudflare · root directory "/" · deploy command "npx wrangler deploy") — เครื่องนี้ไม่มี Docker
// ความลับ: node tools/cloud/put-secrets.mjs (DATABASE_URL · BUDDY_SECRET_KEY) — ไม่อยู่ในไฟล์นี้
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "wts-buddy",
  "main": "cloud/worker.js",
  // สร้างหน้าจอ + ตรวจไฟล์ก่อน docker build (Dockerfile ไม่มี RUN · HANDOFF 115) — deploy ด้วย image เดิม: WTS_SKIP_PREBUILD=1
  "build": { "command": "node cloud/prebuild.mjs" },
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    { "class_name": "AppContainer", "image": "./Dockerfile", "instance_type": "basic", "max_instances": 1,
      // ใกล้ฐานข้อมูลสิงคโปร์ (cloud/worker.js INSTANCE/LOCATION_HINT · HANDOFF ข้อ 108)
      "constraints": { "regions": ["APAC"] } }
  ],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "AppContainer" }] },
  "exports": { "AppContainer": { "type": "durable-object", "storage": "sqlite" } },
  "triggers": { "crons": ["*/5 * * * *"] },
  // ชื่อเว็บสำหรับโปรแกรมคุยกัน (POS/Living/HR → Buddy) — Worker รับเฉพาะ /api/v1 ที่มีกุญแจ API (cloud/worker.js apiGate) · ด่าน Access ต้องตั้ง Bypass เฉพาะชื่อนี้
  // ชื่อเว็บของผู้ใช้ (หน้าเลือกโปรแกรม + Buddy · HANDOFF ข้อ 111) — ด่าน Cloudflare Access ของ Worker ("All traffic") ครอบชื่อนี้ด้วย
  "routes": [
    { "pattern": "buddy-api.worktruesolution.net", "custom_domain": true },
    { "pattern": "app.worktruesolution.net", "custom_domain": true }
  ],
  "vars": {
    "BUDDY_TRUST_PROXY": "1",
    "BUDDY_COOKIE_SECURE": "1"
  }
}
