# ค่าตั้งของการตรวจ S0 (docs/20) — คัดลอกไฟล์นี้ไปเป็น  E:\BuddyAccount\.data\cloud-s0.env  แล้วแก้ค่าในไฟล์นั้น
# .data\ ไม่เข้า git · ห้ามวางรหัสผ่าน/กุญแจในแชทหรือในไฟล์อื่น · บรรทัดที่ยังมี <...> ถือว่ายังไม่ได้ใส่
#
# ฐานข้อมูล: 1 โปรเจกต์ Supabase ต่อ 1 โปรแกรม (ภูมิภาค Southeast Asia (Singapore)) — ต้องเป็นโปรเจกต์ใหม่ที่ว่าง
# Supabase › Project › Connect › "Session pooler" (พอร์ต 5432 · ใช้ได้ทุกเครือข่าย) หรือ "Direct connection" (ต้องมี IPv6)
# ใส่รหัสผ่านฐานข้อมูลแทน [YOUR-PASSWORD] · ถ้ารหัสมีอักขระพิเศษ (@ : / ? # %) ให้ตั้งรหัสใหม่เป็นตัวอักษร+ตัวเลขล้วน
# SSL (แนะนำ): ดาวน์โหลดใบรับรองจาก Project Settings › Database › SSL Configuration ไว้ที่ E:/BuddyAccount/.data/supabase-ca.crt
#   แล้วต่อท้าย URL ด้วย  ?sslmode=verify-full&sslrootcert=E:/BuddyAccount/.data/supabase-ca.crt
BUDDY_DATABASE_URL=<postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres>
WTSPOS_DATABASE_URL=<postgresql://...ของโปรเจกต์ WTS-POS...:5432/postgres>
WTSLIVING_DATABASE_URL=<postgresql://...ของโปรเจกต์ WTS-Living...:5432/postgres>

# ไม่บังคับ: "Transaction pooler" (พอร์ต 6543) ของโปรเจกต์เดียวกัน — ตรวจ SET LOCAL / RLS ผ่าน pooler ด้วย
#BUDDY_POOLER_URL=<postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres>
#WTSPOS_POOLER_URL=<...:6543/postgres>
#WTSLIVING_POOLER_URL=<...:6543/postgres>

# ไม่บังคับ: ที่เก็บไฟล์ Cloudflare R2 (docs/20 ข้อ 9) — bucket ทดสอบ + API token ที่ใช้ได้เฉพาะ bucket นั้น (Object Read & Write)
#R2_ACCOUNT_ID=<รหัสบัญชี Cloudflare 32 ตัว>
#R2_BUCKET=<wts-s0-test>
#R2_ACCESS_KEY_ID=<Access Key ID ของ R2 API token>
#R2_SECRET_ACCESS_KEY=<Secret Access Key ของ R2 API token>
