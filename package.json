{
  "name": "buddy-account",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "db:gen": "python3 db/spec/gen.py",
    "dev:server": "pnpm --filter @buddy/server dev",
    "dev:web": "pnpm --filter @buddy/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @buddy/core test && pnpm --filter @buddy/server test",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @buddy/web build && pnpm --filter @buddy/server start",
    "coverage": "python3 docs/tools/gen_coverage.py",
    "pg": "node tools/local-pg/pg.mjs",
    "build:installer": "node tools/installer/build.mjs",
    "start:pg": "pnpm --filter @buddy/web build && node tools/local-pg/pg.mjs run -- pnpm --filter @buddy/server start",
    "settings:catalog": "pnpm --filter @buddy/server exec tsx ../../tools/express-import/make_settings_catalog.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/windows-x64",
      "esbuild"
    ]
  },
  "devDependencies": {
    "embedded-postgres": "16.14.0-beta.17",
    "kysely": "^0.27.6",
    "pdfjs-dist": "4.10.38",
    "typescript": "^5.9.3"
  }
}
